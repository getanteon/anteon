<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
<meta name="referrer" content="no-referrer">
<title>{{.R.Title}}</title>
<style>
:root{color-scheme:light;
--page:#f9f9f7;--card:#ffffff;--ink:#0b0b0b;--ink2:#52514e;--muted:#898781;--grid:#e1e0d9;--axis:#c3c2b7;--ring:rgba(11,11,11,.10);--band:rgba(11,11,11,.025);--bandw:rgba(11,11,11,.06);
--s1:#2a78d6;--s2:#eb6834;--s3:#1baf7a;--good:#0ca30c;--warn:#fab219;--serious:#ec835a;--crit:#d03b3b;--ref:#52514e;--fillop:.16;--areaop:.10;
--tip:#ffffff;--tipring:rgba(11,11,11,.14);--shadow:0 8px 24px rgba(11,11,11,.10)}
@media (prefers-color-scheme:dark){:root:where(:not([data-theme="light"])){color-scheme:dark;
--page:#0d0d0d;--card:#141413;--ink:#f0efec;--ink2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--ring:rgba(255,255,255,.10);--band:rgba(255,255,255,.025);--bandw:rgba(255,255,255,.06);
--s1:#3987e5;--s2:#d95926;--s3:#199e70;--ref:#c3c2b7;--fillop:.30;--areaop:.20;--tip:#232322;--tipring:rgba(255,255,255,.14);--shadow:0 8px 24px rgba(0,0,0,.5)}}
:root[data-theme="dark"]{color-scheme:dark;
--page:#0d0d0d;--card:#141413;--ink:#f0efec;--ink2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--ring:rgba(255,255,255,.10);--band:rgba(255,255,255,.025);--bandw:rgba(255,255,255,.06);
--s1:#3987e5;--s2:#d95926;--s3:#199e70;--ref:#c3c2b7;--fillop:.30;--areaop:.20;--tip:#232322;--tipring:rgba(255,255,255,.14);--shadow:0 8px 24px rgba(0,0,0,.5)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--page);color:var(--ink);font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:1240px;margin:0 auto;padding:28px 16px 64px}
header{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px}
h1{font-size:22px;letter-spacing:-.015em;margin:0;font-weight:600}
h2{font-size:15px;font-weight:600;margin:32px 0 10px}
h3{font-size:13px;font-weight:600;margin:16px 0 6px}
p{margin:6px 0}
.muted{color:var(--muted)}
button.theme{background:var(--card);color:var(--ink2);border:1px solid var(--ring);border-radius:8px;padding:6px 10px;font:inherit;cursor:pointer}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-top:18px}
.card{background:var(--card);border:1px solid var(--ring);border-radius:10px;padding:12px 14px}
.card .label{color:var(--ink2);font-size:12px}
.card .value{font-size:24px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.card .note{color:var(--muted);font-size:12px;overflow-wrap:anywhere}
.alarm{color:var(--crit)}
.card.alarm{border-color:var(--crit)}
.mark::before{content:"! ";font-weight:700}
.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr))}
.chart{background:var(--card);border:1px solid var(--ring);border-radius:10px;padding:12px 14px 8px;min-width:0}
.chart h3{margin:0}
.chart .sub{color:var(--muted);font-size:12px;margin:1px 0 6px}
.holder{position:relative}
.legend{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:12px;color:var(--ink2);margin:2px 0 4px}
.legend i{display:inline-block;width:14px;height:0;border-top:2px solid;vertical-align:middle;margin-right:6px}
.legend i.dash{border-top-style:dashed}
.legend i.box{height:10px;border:0;border-radius:2px;opacity:.6}
svg{display:block;width:100%;overflow:visible}
svg text{fill:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}
svg text.lab,svg .band-l{fill:var(--ink2)}
svg .halo{fill:var(--ink2);paint-order:stroke;stroke:var(--card);stroke-width:3px;stroke-linejoin:round}
svg .fill{opacity:var(--fillop)}svg .area{opacity:var(--areaop)}
svg:focus{outline:2px solid var(--s1);outline-offset:2px;border-radius:4px}
#tip,.ptip{pointer-events:none;z-index:10;background:var(--tip);border:1px solid var(--tipring);border-radius:8px;box-shadow:var(--shadow);padding:8px 10px;font-size:12px;display:none}
#tip{position:fixed;min-width:180px}.ptip{position:absolute;top:22px;opacity:.96}
#tip .h,.ptip .h{color:var(--ink2);margin-bottom:4px;white-space:nowrap}
#tip .r,.ptip .r{display:flex;align-items:center;gap:8px;white-space:nowrap;line-height:1.7}
#tip .r i,.ptip .r i{width:12px;border-top:2px solid;flex:none}
#tip .r i.dash,.ptip .r i.dash{border-top-style:dashed}
#tip .r i.box,.ptip .r i.box{height:10px;border:0;border-radius:2px;opacity:.6}
#tip .r b,.ptip .r b{font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums;min-width:56px}
#tip .r span,.ptip .r span{color:var(--ink2)}
section.box,.table-wrap{background:var(--card);border:1px solid var(--ring);border-radius:10px;padding:8px 12px}
.table-wrap{overflow-x:auto;margin:8px 0}
table{border-collapse:collapse;width:100%;font-size:13px;font-variant-numeric:tabular-nums}
th,td{text-align:right;padding:7px 8px;border-bottom:1px solid var(--grid);white-space:nowrap}
tr:last-child td{border-bottom:0}
th:first-child,td:first-child,td.name,th.name{text-align:left}
th{color:var(--ink2);font-weight:500;font-size:12px}
td.name{overflow-wrap:anywhere;white-space:normal}
tr.warm td{color:var(--muted)}
.bar{height:6px;background:var(--grid);border-radius:3px;min-width:120px}
.bar>span{display:block;height:100%;background:var(--s1);border-radius:3px}
.bar.alarm>span{background:var(--crit)}
dl.config{display:grid;grid-template-columns:max-content 1fr;gap:4px 16px;margin:0}
dl.config dt{color:var(--muted)}dl.config dd{margin:0}
footer{margin-top:40px;color:var(--muted);font-size:12px;border-top:1px solid var(--grid);padding-top:12px}
</style>
</head>
<body>
<main>
<header>
  <div>
    <h1>{{.R.Title}}</h1>
    <div class="muted">Generated {{.Generated}}. Duration {{.Duration}}. Status: <span class="{{if .StatusAlarm}}alarm mark{{end}}">{{.StatusText}}</span>.</div>
  </div>
  <button class="theme" id="theme" type="button" hidden>Theme</button>
</header>
<div class="cards">
  {{- range .Cards}}
  <div class="card{{if .Alarm}} alarm{{end}}"><div class="label">{{.Label}}</div><div class="value{{if .Alarm}} mark{{end}}">{{.Value}}</div><div class="note">{{.Note}}</div></div>
  {{- end}}
</div>
<noscript><p class="muted">The charts need JavaScript; the tables below do not.</p></noscript>

<section id="load-section">
  <h2>Load</h2>
  <div class="grid" id="load"></div>
</section>

<section id="latency-section">
  <h2>Latency</h2>
  <div class="grid" id="latency"></div>
</section>

<section id="goodput">
  <h2>Goodput</h2>
  {{- if .R.Goodput}}
  <p><strong>{{.GoodputText}}</strong> of {{.R.Goodput.Iterations}} iterations met the SLO, warm-up excluded. An iteration counts when every step succeeded, no assertion failed and every stream ended cleanly within every threshold.</p>
  {{- else}}
  <p class="muted">No SLO was set, so goodput was not computed.</p>
  {{- end}}
  {{- if .SLOText}}
  <p>Thresholds: {{range $i, $t := .SLOText}}{{if $i}}, {{end}}{{$t}}{{end}}.</p>
  {{- end}}
</section>

<section id="outcomes">
  <h2>Outcomes</h2>
  <div class="table-wrap"><table>
    <thead><tr><th class="name">Outcome</th><th>Count</th><th>Share</th><th class="name">&nbsp;</th></tr></thead>
    <tbody>
    {{- range .Outcomes}}
      <tr><td class="name{{if .Alarm}} alarm mark{{end}}">{{.Label}}</td><td>{{.Count}}</td><td>{{.Perc}}</td><td class="name"><div class="bar{{if .Alarm}} alarm{{end}}"><span style="width: {{.Width}}"></span></div></td></tr>
    {{- end}}
    </tbody>
  </table></div>
</section>

{{- if or .TokenMetrics .TokenFacts}}
<section id="tokens">
  <h2>Answers' output{{if .TokenUnit}} <span class="muted">(in {{.TokenUnit}})</span>{{end}}</h2>
  {{- range .TokenFacts}}
  <p>{{.}}</p>
  {{- end}}
  {{- if .TokenMetrics}}
  <div class="table-wrap"><table>
    <thead><tr><th class="name">Metric</th><th>Count</th><th>p50</th><th>p90</th><th>p95</th><th>p99</th><th>Max</th><th>Mean</th></tr></thead>
    <tbody>
    {{- range .TokenMetrics}}
      <tr><td class="name">{{.Name}}</td><td>{{.Count}}</td><td>{{.P50}}</td><td>{{.P90}}</td><td>{{.P95}}</td><td>{{.P99}}</td><td>{{.Max}}</td><td>{{.Mean}}</td></tr>
    {{- end}}
    </tbody>
  </table></div>
  {{- end}}
</section>
{{- end}}

{{- if .Stages}}
<section id="stages">
  <h2>Stages</h2>
  <div class="grid" id="stagecharts"><div class="chart" id="stage-outcomes"></div><div class="chart" id="stage-dist"></div></div>
  <div class="table-wrap"><table>
    <thead><tr><th>#</th><th class="name">Stage</th><th>Iterations</th><th>OK</th><th>Goodput</th><th>429</th><th>503</th><th>Other 5xx</th><th>Timeout</th><th>Network</th><th>Cut</th><th>TTFT p50</th><th>TTFT p95</th><th>E2E p50</th><th>E2E p95</th></tr></thead>
    <tbody>
    {{- range .Stages}}
      <tr><td>{{.Index}}</td><td class="name">{{.Name}}{{if .WarmupNote}} <span class="muted">(warm-up)</span>{{end}}</td><td>{{.Iterations}}</td><td>{{.OK}}</td><td>{{.Goodput}}</td><td class="{{if .Has429}}alarm mark{{end}}">{{.R429}}</td><td class="{{if .Has503}}alarm mark{{end}}">{{.R503}}</td><td>{{.R5xx}}</td><td>{{.Timeout}}</td><td>{{.Network}}</td><td>{{.Cut}}</td><td>{{.FTp50}}</td><td>{{.FTp95}}</td><td>{{.Totp50}}</td><td>{{.Totp95}}</td></tr>
    {{- end}}
    </tbody>
  </table></div>
  <p class="muted">Times in milliseconds. A warm-up stage is left out of the whole test's figures.</p>
</section>
{{- end}}

{{- if .SteadyRows}}
<section id="steady">
  <h2>Steady state, from the request records</h2>
  <div class="table-wrap"><table>
    <thead><tr><th class="name">Stage</th><th>Settle excluded (s)</th><th>Requests</th><th>Succeeded</th><th>No first token</th><th>503</th><th>Other failure</th><th>Within SLO</th><th>First token p50</th><th>p95 [95% CI]</th><th>Total p50</th><th>p95 [95% CI]</th></tr></thead>
    <tbody>
    {{- range .SteadyRows}}
      <tr{{if .Warmup}} class="warm"{{end}}><td class="name">{{.Name}}</td><td>{{.Settle}}</td><td>{{.Steady}}</td><td>{{.Answered}}</td><td>{{.NoText}}</td><td>{{.Rejected}}</td><td>{{.Failed}}</td><td>{{.Good}}</td><td>{{.FTp50}}</td><td>{{.FTp95}}</td><td>{{.Totp50}}</td><td>{{.Totp95}}</td></tr>
    {{- end}}
    </tbody>
  </table></div>
  {{- if .StepRows}}
  <h3>Per step</h3>
  <div class="table-wrap"><table>
    <thead><tr><th class="name">Stage</th><th class="name">Step</th><th>Succeeded</th><th>First token p50</th><th>p95</th><th>Total p50</th><th>p95</th></tr></thead>
    <tbody>
    {{- range .StepRows}}
      <tr{{if .Warmup}} class="warm"{{end}}><td class="name">{{.Stage}}</td><td class="name">{{.Step}}</td><td>{{.N}}</td><td>{{.FTp50}}</td><td>{{.FTp95}}</td><td>{{.Totp50}}</td><td>{{.Totp95}}</td></tr>
    {{- end}}
    </tbody>
  </table></div>
  {{- end}}
  <p class="muted">Times in milliseconds, of {{with .Steady}}{{range $i, $s := .Steps}}{{if $i}}, {{end}}{{$s}}{{end}}{{end}}. At the start of each stage the requests of iterations that began within max(the sliding window, the previous stage's p95 total) are left out, so the system is not measured before it settles at the new load. The window is half the shortest stage past warm-up, from 10 to 60 seconds. p99 needs 100 answers.{{if .Steady.Sampled}} Above {{.PerStep}} requests a step is measured from a uniform sample.{{end}}</p>
</section>
{{- end}}

{{- if .Steps}}
<section id="steps">
  <h2>Steps</h2>
  {{- range .Steps}}
  <h3>{{.ID}}. {{.Name}}</h3>
  <p class="muted">{{.Success}} succeeded, {{.Failed}} failed.</p>
  {{- if .Metrics}}
  <div class="table-wrap"><table>
    <thead><tr><th class="name">Metric (ms)</th><th>Count</th><th>p50</th><th>p90</th><th>p95</th><th>p99</th><th>Max</th><th>Mean</th></tr></thead>
    <tbody>
    {{- range .Metrics}}
      <tr><td class="name">{{.Name}}</td><td>{{.Count}}</td><td>{{.P50}}</td><td>{{.P90}}</td><td>{{.P95}}</td><td>{{.P99}}</td><td>{{.Max}}</td><td>{{.Mean}}</td></tr>
    {{- end}}
    </tbody>
  </table></div>
  {{- end}}
  {{- if .Outcomes}}
  <p>{{range $i, $o := .Outcomes}}{{if $o.Nonzero}}<span class="{{if $o.Alarm}}alarm mark{{end}}">{{$o.Label}} {{$o.Count}}</span>&emsp;{{end}}{{end}}</p>
  {{- end}}
  {{- end}}
</section>
{{- end}}

<section id="config">
  <h2>Configuration</h2>
  <p class="muted">The shape of the load only. Addresses, headers, bodies, credentials and test data are not in this file.</p>
  <dl class="config">
    {{- with .R.Config}}
    {{- if .LoadType}}<dt>Load type</dt><dd>{{.LoadType}}</dd>{{end}}
    {{- if .LoadSpread}}<dt>Load spread</dt><dd>{{.LoadSpread}}</dd>{{end}}
    {{- if .Iterations}}<dt>Iterations</dt><dd>{{.Iterations}}</dd>{{end}}
    {{- if .DurationS}}<dt>Duration</dt><dd>{{.DurationS}} s</dd>{{end}}
    {{- end}}
    {{- if .SLOText}}<dt>SLO</dt><dd>{{range $i, $t := .SLOText}}{{if $i}}, {{end}}{{$t}}{{end}}</dd>{{end}}
  </dl>
  {{- if .R.Config.Stages}}
  <h3>Planned stages</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>#</th><th class="name">Name</th><th>Duration (s)</th><th>Iterations</th><th>Warm-up</th></tr></thead>
    <tbody>
    {{- range $i, $s := .R.Config.Stages}}
      <tr><td>{{inc $i}}</td><td class="name">{{$s.Name}}</td><td>{{$s.DurationS}}</td><td>{{$s.Count}}</td><td>{{if $s.Warmup}}yes{{else}}no{{end}}</td></tr>
    {{- end}}
    </tbody>
  </table></div>
  {{- end}}
  {{- if .R.Config.Steps}}
  <h3>Steps</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>ID</th><th class="name">Name</th><th>Stream</th><th>Timeout (s)</th></tr></thead>
    <tbody>
    {{- range .R.Config.Steps}}
      <tr><td>{{.ID}}</td><td class="name">{{.Name}}</td><td>{{if .Stream}}yes{{else}}no{{end}}</td><td>{{if .TimeoutS}}{{.TimeoutS}}{{else}}-{{end}}</td></tr>
    {{- end}}
    </tbody>
  </table></div>
  {{- end}}
</section>

<footer>Written by Ddosify. This file is self-contained and loads nothing from the network.</footer>
</main>
<script type="application/json" id="data">{{.Data}}</script>
<script>{{.Script}}</script>
</body>
</html>
