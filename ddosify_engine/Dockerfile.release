# Used by goreleaser's dockers_v2, which puts each platform's binary under $TARGETPLATFORM/
FROM gcr.io/distroless/static-debian13:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/ddosify /usr/bin/ddosify
USER 65532:65532
ENTRYPOINT ["/usr/bin/ddosify"]
CMD ["--help"]
